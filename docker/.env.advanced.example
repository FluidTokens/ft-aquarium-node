# Optional settings — a MENU, not a file the stack reads.
#
# Copy the lines you want into your `.env` and restart. Compose loads `.env` only; this file
# exists so the six things you must set are not buried among the thirty you need not.
#
# ⛔ Everything here ships in a safe position. An operator who never opens this file gets a node
# that indexes the chain, serves /healthcheck, and touches no funds.


# ══ Arming ════════════════════════════════════════════════════════════════════════════════
# ⛔ Read docs/deploying.md §8 before changing any of these, and rehearse in `shadow` first.

# The Aquarium scheduled-transaction processor. This is the part you stake 30,000 FLDT for.
SCHEDULING_TRANSACTION_PROCESSOR_ENABLED=false

# The lending-v4 liquidation bot.
#   disabled  scans nothing
#   shadow    scans, prices, BUILDS and size-checks real liquidations, submits none of them
#             (⚠ wallet rebalances, below, ARE signed and submitted in shadow)
#   live      submits
AQUARIUM_LIQUIDATION_MODE=disabled

# The compound loop.
AQUARIUM_COMPOUND_ENABLED=false

# Wallet rebalancing. ⚠ ON BY DEFAULT, but it acts only when AQUARIUM_LIQUIDATION_MODE is shadow
# or live AND at least one market is `action: ANTICIPATE` with an effective mode of shadow or live,
# and only once the node is synced. Then, after every block, if the wallet has drifted out of
# shape, the node SIGNS AND SUBMITS one self-send of its whole wallet — in shadow too: it is wallet
# housekeeping, not a liquidation. It needs the shaped outputs (10 ADA per ANTICIPATE token, 10 ADA
# for any other tokens, ~5 ADA collateral) PLUS a change larger than the largest of them, plus the
# fee — one ANTICIPATE token needs a bit over 25 ADA under current parameters. A wallet too small
# to shape is logged at WARN (`[REBALANCE] REFUSED: …`; an empty one `[REBALANCE] NOTHING_TO_DO: …`)
# on every block and nothing is submitted. ⛔ The self-send spends EVERY wallet UTxO, so keep no
# reference-script or datum UTxO in this wallet: a datum UTxO is consumed and its datum not
# recreated, and a reference-script UTxO is expected to make every rebalance fail at submission.
# `false` (and a restart) turns it off; nothing on the readiness page can turn it back on.
# See docs/deploying.md §9, "Wallet rebalancing".
AQUARIUM_WALLET_REBALANCE_ENABLED=true


# ══ Economics ═════════════════════════════════════════════════════════════════════════════
# ⛔ ONE margin governs EVERY mode — plain, anticipate and convert alike. There is no separate
# convert margin, so lowering this to take on convert work lowers it for anticipate work too.
# This is the setting that most often makes a node look armed while doing nothing.
AQUARIUM_LIQUIDATION_PROFIT_MARGIN_LOVELACE=5000000

# Global DEX switch. `false` means this node touches no DEX, whatever the markets below say.
LOANS_LIQUIDATION_CONVERT_ENABLED=true


# ══ Markets ═══════════════════════════════════════════════════════════════════════════════
# ⛔ `UNIT` is the loan's PRINCIPAL asset — what was lent — NOT the collateral. An entry keyed by
# the collateral is well-formed, boots cleanly, and matches no loan. That market is then treated
# as unlisted, AND AN UNLISTED MARKET CONVERTS BY DEFAULT — so a `DISABLED` written against the
# wrong asset does the opposite of what it says, silently.
#
# You do NOT list a market to get CONVERT; that is the default everywhere. Listing one is how
# you deviate. Index groups the fields of a single market. See docs/deploying.md §9.
#
# LOANS_LIQUIDATION_MARKETS_0_UNIT=lovelace
# LOANS_LIQUIDATION_MARKETS_0_ACTION=CONVERT
#
# ANTICIPATE repays the lender FROM YOUR OWN WALLET and keeps the collateral. CAP is mandatory
# for it — the node refuses to start without one — and is in that asset's own units.
# LOANS_LIQUIDATION_MARKETS_1_UNIT=<policyid><assetname hex>
# LOANS_LIQUIDATION_MARKETS_1_ACTION=ANTICIPATE
# LOANS_LIQUIDATION_MARKETS_1_CAP=500000000
#
# MODE is per market and the node mode is a CEILING: a market asking for LIVE on a shadow node
# runs as SHADOW, and says so at boot.
# LOANS_LIQUIDATION_MARKETS_2_UNIT=<policyid><assetname hex>
# LOANS_LIQUIDATION_MARKETS_2_MODE=DISABLED


# ══ Operator UI ═══════════════════════════════════════════════════════════════════════════
# The readiness page at /api/v1/loans/readiness. No authentication in front of it.
#
# ⚠ THIS FLAG DOES NOT CLOSE PORT 8080. It removes the HTML page (and its two buttons) only.
# /api/v1/loans, /api/v1/loans/liquidations, /api/v1/loans/oracle, /healthcheck and /actuator/*
# stay up and still disclose your positions. The exposure decision is about the PORT — docs/deploying.md §7.
#
# ⚠ The page is not entirely read-only: it has Suspend / Resume buttons for wallet rebalancing
# (in memory — a restart resumes it; Resume cannot override AQUARIUM_WALLET_REBALANCE_ENABLED=false).
# With no authentication, ANYONE who can reach the page can press them.
LOANS_UI_ENABLED=false

# The page's summary shows the collateral locked in live loans (TVL) in ADA, and an ESTIMATED USD
# value. ⚠ The USD figure is NOT a USD quote: it is the ADA value converted at the USDM oracle
# price, counting 1 USDM as $1. USDM can trade off its peg and the oracle can lag, so read it as an
# estimate. This is the USDM token's unit, and mainnet's is the default. ONLY USDM is supported:
# the page labels the figure as USDM-based, so another token's unit would be mislabelled. It exists
# to correct the USDM unit or to turn USD off. Leave this unset to keep the default; set it empty
# to turn USD off, and the page then shows "USD unavailable". On preview it is blank, and the page
# shows "USD unavailable" too.
# ⛔ Keep it commented out unless you mean it: a value set here beats the network profile, so a
# mainnet unit uncommented on a preview node would apply there too.
# LOANS_UI_USD_REFERENCE_UNIT=


# ══ Resources ═════════════════════════════════════════════════════════════════════════════
# ⚠ The JVM heap is sized as a PERCENTAGE OF THIS LIMIT. Without a limit it is a percentage of
# the whole host, and the JVM will size its heap against RAM other things are using.
AQUARIUM_MEM_LIMIT=4g


# ══ Network ═══════════════════════════════════════════════════════════════════════════════
# Empty for mainnet. `preview` for preview.
SPRING_PROFILES_ACTIVE=


# ══ ⛔ NOT HERE, AND DELIBERATELY ═════════════════════════════════════════════════════════
# Contract coordinates — config policy ids, every reference-script hash, the sync start point.
#
# They ship inside the image, verified against the chain before release. A stale override is
# strictly worse than no override: it silently replaces a maintained value with a frozen one,
# and the failure is not a crash. It is a node that starts cleanly, verifies cleanly, and
# quietly watches a dead deployment.
#
# ⇒ When FluidTokens redeploy, you bump AQUARIUM_DOCKER_IMAGE_VERSION. Nothing else.
