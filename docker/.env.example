AQUARIUM_DOCKER_IMAGE_NAME=fluidtokens/ft-aquarium-node
AQUARIUM_DOCKER_IMAGE_VERSION=latest

## Spring Configuration

# uncomment below for preview
#SPRING_PROFILES_ACTIVE=preview

## DB Configuration
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
POSTGRES_HOST=aquarium-pg
POSTGRES_PORT=5432
POSTGRES_DB=aquarium
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=password

## Yaci Store Configuration
# preview
#STORE_CARDANO_HOST=preview-node.world.dev.cardano.org
# mainnet
STORE_CARDANO_HOST=backbone.cardano.iog.io
# STORE_CARDANO_HOST=backbone.mainnet.cardanofoundation.org
# STORE_CARDANO_HOST=backbone.mainnet.emurgornd.com
STORE_CARDANO_PORT=3001

## Blockfrost Key
BLOCKFROST_KEY=

## Wallet Seed (mnemonic)
WALLET_MNEMONIC=lorem ipsum

## Lending v4 auto-liquidation bot (PREVIEW ONLY)
# Full guide: docs/operating-the-liquidation-bot.md
#
# Off by default, and arming takes TWO deliberate changes plus the preview profile: the mode
# must be `live` AND the enabled flag must be true. Leave both alone unless you mean it —
# submitting a liquidation burns the loan NFT and moves someone's collateral.
#LOANS_ENABLED=true
#AQUARIUM_LIQUIDATION_MODE=disabled          # disabled | shadow | live (preview default: shadow)
#AQUARIUM_LIQUIDATION_ENABLED=false          # the separate arming flag
#AQUARIUM_LIQUIDATION_DELAY_SECONDS=60
#AQUARIUM_LIQUIDATION_VALIDITY_WINDOW_SECONDS=120
#AQUARIUM_LIQUIDATION_ORACLE_MARGIN_SECONDS=30
#AQUARIUM_LIQUIDATION_PROFIT_MARGIN_LOVELACE=1500000
#AQUARIUM_LIQUIDATION_DECISION_LOG_SIZE=200
#AQUARIUM_LIQUIDATION_QUARANTINE_MINUTES=30
#
# Published reference-script UTxOs, `txHash#index` each. WITHOUT THESE THE BOT CANNOT SUBMIT:
# the six validators total 18_584 bytes against a 16_384-byte maxTxSize. The preview profile
# already ships verified coordinates, so override these only if FluidTokens republishes.
#AQUARIUM_LIQUIDATION_REF_LOAN=
#AQUARIUM_LIQUIDATION_REF_LOAN_SPEND=
#AQUARIUM_LIQUIDATION_REF_LENDER_MANAGER=
#AQUARIUM_LIQUIDATION_REF_LENDER_MANAGER_SPEND=
#AQUARIUM_LIQUIDATION_REF_LOAN_CLAIM_ACTION=
#AQUARIUM_LIQUIDATION_REF_LM_LIQUIDATE_ACTION=
#AQUARIUM_LIQUIDATION_REF_ASSET_MANAGER=
