# FluidTokens Aquarium Node — everything you must set, and nothing you must not.
#
# Six values. Copy to `.env`, fill them in, `docker compose up -d`.
#
#   cp .env.example .env && chmod 600 .env
#
# ⛔ chmod 600: this file holds a seed phrase.
#
# Everything else has a working default in docker-compose.yaml, and the contract coordinates
# ship inside the image — verified against the chain before release. When FluidTokens redeploy,
# you bump AQUARIUM_DOCKER_IMAGE_VERSION. You never edit a script hash.
#
# Turning the bot on, market policy, the operator UI and the profit margin are OPTIONAL. They
# live in `.env.advanced.example` — a menu, not a second file the stack loads. Copy the lines you
# want into your `.env` and restart. Nothing there is needed to get running. See docs/deploying.md.


# ── Your Cardano relay ────────────────────────────────────────────────────────────────────
# The chain feed. A local node, or any relay you can reach. The default below is IOG's public
# backbone; it works, and it is shared with everyone else using it.
STORE_CARDANO_HOST=backbone.cardano.iog.io
STORE_CARDANO_PORT=3001


# ── Blockfrost ────────────────────────────────────────────────────────────────────────────
# How transactions are submitted. The free plan is enough. https://blockfrost.io
BLOCKFROST_KEY=


# ── The node's wallet ─────────────────────────────────────────────────────────────────────
# ⛔ A DEDICATED wallet, used for nothing else. The node signs with it automatically and
# unattended. It needs ~10 ADA, plus whatever principal you choose to front IF you enable
# ANTICIPATE markets (advanced).
#
# ⚠ The 30,000 FLDT does NOT live here — it is delegated to this wallet from a separate wallet,
# which can be cold. That separation is the point.
WALLET_MNEMONIC=


# ── Database ──────────────────────────────────────────────────────────────────────────────
# Credentials for the Postgres that Compose starts for you. Pick a real password; it is not
# reachable from outside the host, but it is still a password.
DB_USERNAME=aquarium
DB_PASSWORD=


# ── Image ─────────────────────────────────────────────────────────────────────────────────
# ⚠ PIN A VERSION rather than tracking `latest`, so a restart months from now cannot silently
# change what you run.
#
# Tags look like `2026.09.22-413f16cb32fb` — the build date, then the commit the image was built
# from. The date orders them; the commit makes each one permanent, so a tag you pin today is the
# same bytes forever. The commit half is exactly what /actuator/info reports as `commitShort`, so
# you can check what is running against what you pinned by eye.
#
# ⚠ `latest` MOVES. Fine for trying the node, wrong for running one.
AQUARIUM_DOCKER_IMAGE_VERSION=latest
