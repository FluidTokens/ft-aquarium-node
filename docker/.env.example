STORE_CARDANO_PORT=3001

## Blockfrost Key
BLOCKFROST_KEY=

## Wallet Seed (mnemonic)
# KEEP THE QUOTES. Unquoted, a multi-word value is word-split if this file is ever sourced
# in a shell (`. ./.env`), and the shell tries to execute each word as a command — leaking
# mnemonic words into stderr and shell history. Docker Compose itself is unaffected, but
# people do source these files.
WALLET_MNEMONIC="lorem ipsum"

## Lending v4 auto-liquidation bot
# Full guide: docs/operating-the-liquidation-bot.md
# ⛔ BEFORE ARMING ON MAINNET, read section 14 of that guide. It is short and it is the
#    difference between a bot that works and one that routes the only live loan to a dead path.
#
# ── The arming switches. On MAINNET there are FOUR, not two. ────────────────────────────────
#
# Each one is a separate refusal inside the executor, so setting three of them submits nothing
# and the log says which one held. Leave them alone unless you mean it — a submitted
# liquidation burns the loan NFT and moves someone's collateral.
#LOANS_ENABLED=true                          # without it the lending beans do not exist at all
#AQUARIUM_LIQUIDATION_MODE=disabled          # disabled | shadow | live   (S1: MODE_NOT_LIVE)
#AQUARIUM_LIQUIDATION_ENABLED=false          # the separate arming flag   (S2: NOT_ARMED)
#LOANS_SUBMITTABLE_NETWORK=preview           # (S3: NETWORK_NOT_PREVIEW)
#
# ⛔ THAT LAST ONE IS THE LAST BARRIER, and it defaults to `preview` on every profile. A
#    mainnet node with the other three set still submits NOTHING and logs NETWORK_NOT_PREVIEW.
#    Changing it is the moment to stop and get a second pair of eyes.
#
#AQUARIUM_LIQUIDATION_DELAY_SECONDS=60
#AQUARIUM_LIQUIDATION_VALIDITY_WINDOW_SECONDS=120
#AQUARIUM_LIQUIDATION_ORACLE_MARGIN_SECONDS=30
#AQUARIUM_LIQUIDATION_PROFIT_MARGIN_LOVELACE=1500000
#AQUARIUM_LIQUIDATION_DECISION_LOG_SIZE=200
#AQUARIUM_LIQUIDATION_QUARANTINE_MINUTES=30

# ── Per-market policy: WHICH transaction the bot builds ─────────────────────────────────────
#
# ⛔ AN UNLISTED MARKET IS `CONVERT`. That is the right default in general — convert fronts no
#    capital — but the convert path CANNOT EXECUTE on mainnet today: FluidTokens' action
#    validator was compiled against a Minswap datum shape that is not what is deployed
#    (findings section 51). Their fix, not ours, and not in yet.
#
# ⇒ Measured 2026-09-03: the ONE live mainnet loan permits conversion, so with no market
#   listed it routes to that dead path. The market below is what makes it work instead.
#
# ✅ The shipped default is SAFE: with no configuration the gate returns MARKET_DISABLED and
#    the bot REFUSES. The danger is only a HALF-configured arming — raising the mode without
#    saying which mechanism the market uses.
#
# ⚠ `unit` is the loan's PRINCIPAL asset. The mainnet loan's collateral is FLDT and its
#   principal is ada, so the market is `lovelace`. Keying it on the FLDT unit creates a market
#   that matches nothing and leaves the real one unlisted — silently back on CONVERT.
#
# ⚠ And a list is NOT one variable: it is indexed keys, one set per market.
#LOANS_LIQUIDATION_MARKETS_0_UNIT=lovelace
#LOANS_LIQUIDATION_MARKETS_0_MODE=SHADOW      # DISABLED | SHADOW | LIVE; the node mode is a CEILING
#LOANS_LIQUIDATION_MARKETS_0_ACTION=ANTICIPATE  # CONVERT | ANTICIPATE
#LOANS_LIQUIDATION_MARKETS_0_CAP=50000000     # lovelace; MANDATORY on ANTICIPATE
#
# ⛔ THE CAP IS A GATE, NOT A CLAMP. The protocol fixes what must be deposited and the bot
#    cannot front part of a loan, so a cap BELOW the requirement refuses the candidate rather
#    than building something smaller. Size it from the amount FRONTED, never from the debt —
#    on the live mainnet candidate those are 20,887,781 and 20,001,060 lovelace, and a cap
#    chosen from the debt would refuse the very candidate it was meant to allow.
#
# ⛔ AND ANTICIPATE NEEDS A FUNDED WALLET. The bot PAYS ada and is paid in COLLATERAL TOKENS:
#    after that liquidation the wallet is ~20.9 ADA poorer and holds 100,000,000 FLDT. That is
#    the intended end state — accrued collateral is HELD, and disposing of it is your decision,
#    not the bot's. A FALLING ADA BALANCE ON THIS PATH IS CORRECT BEHAVIOUR, NOT A FAULT.
#    You need ONE ada-only UTxO covering the fronted amount plus fee headroom — a single input,
#    not a total balance. Shadow withholds the SUBMIT, not the WALLET: a wallet-less node in
#    shadow produces nothing, which looks exactly like a quiet market.

# ── Published reference-script UTxOs — WITHOUT THESE THE BOT CANNOT SUBMIT ───────────────────
#
# The validators total 18,584 bytes against a 16,384-byte maxTxSize, so they cannot all travel
# inline. Referencing them costs fee instead of size (~0.28 ADA per liquidation at
# minFeeRefScriptCostPerByte 15), which profit-margin-lovelace has to cover.
#
# The PREVIEW profile ships its own verified coordinates; override only if FluidTokens
# republishes. The MAINNET values below are FluidTokens' own publications, verified read-only
# against mainnet and re-checked by MainnetReferenceScriptsTest: each one publishes exactly the
# validator its key names, and each sits at an enterprise SCRIPT address, so coin selection
# cannot spend it (CCL trap 9b is closed structurally).
#
# ⚠ They are NOT defaulted in application.yaml, deliberately. LoansReferenceScriptVerifier
#   hard-fails at boot on a coordinate that no longer publishes the derived hash, so a stale
#   DEFAULT would break every node the day FluidTokens redeploy. Here you opt in, and the
#   hard-fail is an answer rather than an outage.
#
# MAINNET (FluidTokens, verified 2026-09-03):
#AQUARIUM_LIQUIDATION_REF_LOAN=f87ed9cc0fd53fd5d8d9c88bfac066fa741aa927e98e5c001496bfb4c82db84f#0
#AQUARIUM_LIQUIDATION_REF_LOAN_SPEND=46d7195856788885fd4a488dff7bde8bbaf46d5dc4a2fa3dbd12e9cb42129c96#0
#AQUARIUM_LIQUIDATION_REF_LENDER_MANAGER=ebc11a0346719772709390b11156f6e3b46c5b39d305f80c1f842ceadc9a242b#0
#AQUARIUM_LIQUIDATION_REF_LENDER_MANAGER_SPEND=55a67ecdf41df12275588f01a33cb4d0c88345e05bec7a52be4099dff9597d3d#0
#AQUARIUM_LIQUIDATION_REF_LOAN_CLAIM_ACTION=51eaf4994ee313bf4c95be65656e092d7366b0f397f7ecc1e0113c063fab5f98#0
#AQUARIUM_LIQUIDATION_REF_LM_LIQUIDATE_ACTION=8ba0dfb30d40361b9bc775f032e2427c799a6cfefce0cbf13e8f1242c990249a#0
#AQUARIUM_LIQUIDATION_REF_LM_LIQUIDATE_AND_PAY_IN_ADVANCE_ACTION=2ed58f66779acd64f9add3755dd0686d6841001c90683b369cae0f5f07287476#0
#AQUARIUM_LIQUIDATION_REF_ASSET_MANAGER=e5e5bab0c7b39a929af8516f940811ca483dbc23ba647a664c1463c2a70b3fe0#0

# ── The COMPOUND path (a different action: collect a repaid loan and deliver it to the pool) ─
#
# ⚠ Measured on mainnet 2026-09-03: no loan has ever been repaid there (one loan minted, never
#   burned), so no escrow exists to compound; and the only live pool manager publishes
#   compoudingFeePerMille = 0, so the work would pay NOTHING and be refused at the margin of 0
#   regardless. Leave this off on mainnet until a pool owner publishes a non-zero fee.
#
# ⚠ ONE comma-separated list, not named keys — the node reads referenceScriptHash off the
#   chain, so a mislabelled coordinate is not expressible here. Eleven inline validators build
#   a 24,912-byte transaction against a 16,384 maxTxSize; referencing the four largest measures
#   10,414 bytes.
#AQUARIUM_COMPOUND_ENABLED=false
#AQUARIUM_COMPOUND_PROFIT_MARGIN_LOVELACE=0
#AQUARIUM_COMPOUND_REFERENCE_SCRIPTS=83d1c5393a53e365eb15a7bdfd1feff560f43f9560bc60c23c4e41de709bae33#0,55a67ecdf41df12275588f01a33cb4d0c88345e05bec7a52be4099dff9597d3d#0,d0549a87da42d048eb1c3b5b8f7811fd2ccd882ad36c85ee209d3a8d1ca0265f#0,d52f3f88e44ca798d9f45313b83267a7ffa01a6105603ed2b2aebcd8383c45ea#0,e5e5bab0c7b39a929af8516f940811ca483dbc23ba647a664c1463c2a70b3fe0#0,ebc11a0346719772709390b11156f6e3b46c5b39d305f80c1f842ceadc9a242b#0,954f8be5773c3ebce3377ecb7a420f407ef18500638bb6d7db0022ed9e9b7c50#0,5215ca557800881b044ce92c77018b92b9d5b6c56f835d6217bc7e1435000f8a#0,8340312072cd352519e01d7e294d3a4cb84a7f0b63f44adef027abf84d2e0bee#0,8bfb510d6d90573280d9a47b94411477f0992228e0b43cb7cb864f2af66b6812#0,15d88c19c9841e7b5cdd125613ff2013993aeb89f871f340c7a2e43fce1373f5#0
