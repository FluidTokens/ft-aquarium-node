# Template for .env.preview — copy to `.env.preview` and fill in.
#
#   cp .env.preview.example .env.preview
#
# `.env.preview` is gitignored and must stay that way: it holds a wallet mnemonic and an API
# key. This template is tracked precisely so that a fresh clone can see WHAT is needed without
# ever seeing WHAT IT IS. Placeholder values only — never paste a real key or mnemonic here.
#
# What this file is for: running the preview live checks and, when deliberately armed, the
# Lending v4 liquidation bot against the preview network. It is NOT the deployment config —
# operators running the Docker image use `docker/.env` (see `docker/.env.example`).
#
# Usage in a shell, for the env-gated live tests:
#   set -a; . ./.env.preview; set +a
#   ./gradlew test --tests '*LoansConfigVerifierLiveTest*'

## ---------------------------------------------------------------------------------------
## Required
## ---------------------------------------------------------------------------------------

# Blockfrost project id for the PREVIEW network. Create a free project at
# https://blockfrost.io/dashboard — make sure the project's network is Preview, not Mainnet
# or Preprod; a mainnet key against preview data fails with a 403 that looks like an outage.
# Used by: the live verification tests, the reference-script startup check, and (when armed)
# transaction submission.
BLOCKFROST_KEY=previewXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 24-word BIP-39 mnemonic for a DEDICATED preview wallet. Generate a fresh one — never reuse
# a wallet that holds anything you care about, and never a mainnet seed. Fund it from the
# preview faucet at https://docs.cardano.org/cardano-testnets/tools/faucet/ using the
# wallet's base address.
#
# How much it needs depends on what you are doing: paying transaction fees is a few ada; if
# you intend to CREATE a loan fixture (acting as lender and borrower to drive a loan into the
# liquidatable band) the wallet must also carry the principal and collateral, which is
# substantially more. See docs/operating-the-liquidation-bot.md.
WALLET_MNEMONIC=word1 word2 word3 ... word24

## ---------------------------------------------------------------------------------------
## Optional — the liquidation bot. Defaults are safe; every one of these is off or inert
## unless you change it deliberately. Full guide: docs/operating-the-liquidation-bot.md
## ---------------------------------------------------------------------------------------

# Master switch for all Lending v4 code (indexing, health endpoints, the bot). Without this
# the liquidation beans do not exist at all. Preview only — mainnet stays disabled until
# FluidTokens confirms deployment coordinates.
#LOANS_ENABLED=true

# disabled | shadow | live.  The preview profile defaults to `shadow`: the loop scans, builds
# real transactions and records what it WOULD have done, without submitting anything. Read
# those decisions at GET /api/v1/loans/liquidations before you consider arming.
#AQUARIUM_LIQUIDATION_MODE=shadow

# The second, independent arming switch. `live` mode alone does NOT submit — this must also
# be true. Two switches on purpose: one flag flipped by accident must not arm the bot.
# Submitting a liquidation burns the loan NFT and moves someone's collateral.
#AQUARIUM_LIQUIDATION_ENABLED=false

# Loop cadence, and the transaction's validity window / required oracle headroom in seconds.
# The preview Charli3 feed window is 600s; the margin is what must REMAIN after the
# transaction's validity ends, so a large margin silently starves the bot.
#AQUARIUM_LIQUIDATION_DELAY_SECONDS=60
#AQUARIUM_LIQUIDATION_VALIDITY_WINDOW_SECONDS=120
#AQUARIUM_LIQUIDATION_ORACLE_MARGIN_SECONDS=30

# Profit floor in lovelace: the bot submits only when the liquidation fee, valued in ada,
# exceeds the transaction fee plus this margin. It must cover the reference-script surcharge
# (~0.28 ada when all six validators are referenced).
#AQUARIUM_LIQUIDATION_PROFIT_MARGIN_LOVELACE=1500000

# How many decisions the in-memory log keeps, and how long a loan is skipped after a failed
# or attempted submission. The log does NOT survive a restart.
#AQUARIUM_LIQUIDATION_DECISION_LOG_SIZE=200
#AQUARIUM_LIQUIDATION_QUARANTINE_MINUTES=30

# Published reference-script UTxOs, `txHash#index` each. WITHOUT THESE THE BOT CANNOT SUBMIT:
# the six validators total 18,584 bytes against a 16,384-byte maxTxSize, and a real
# single-loan liquidation measured 19,838 bytes carrying its own scripts. The preview profile
# already ships coordinates that are verified against the derived script hashes at startup,
# so override these only if FluidTokens republishes — and expect startup to hard-fail until
# you do, which is the intended signal.
#AQUARIUM_LIQUIDATION_REF_LOAN=
#AQUARIUM_LIQUIDATION_REF_LOAN_SPEND=
#AQUARIUM_LIQUIDATION_REF_LENDER_MANAGER=
#AQUARIUM_LIQUIDATION_REF_LENDER_MANAGER_SPEND=
#AQUARIUM_LIQUIDATION_REF_LOAN_CLAIM_ACTION=
#AQUARIUM_LIQUIDATION_REF_LM_LIQUIDATE_ACTION=
#AQUARIUM_LIQUIDATION_REF_ASSET_MANAGER=

## ---------------------------------------------------------------------------------------
## Optional — local database, if you run the node rather than only the tests. Defaults in
## application.yaml point at localhost; see the README for creating the dev database.
## ---------------------------------------------------------------------------------------
#DB_URL=jdbc:postgresql://localhost:5432/aquarium
#DB_USERNAME=fluidtokens
#DB_PASSWORD=password
#DB_SCHEMA=public
